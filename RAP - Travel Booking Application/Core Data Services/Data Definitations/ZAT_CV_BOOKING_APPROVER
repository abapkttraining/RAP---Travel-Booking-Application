@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Projection view for the approver booking entity'
@Metadata.ignorePropagatedAnnotations: true
@Metadata.allowExtensions: true
define view entity ZAT_CV_BOOKING_APPROVER
  as projection on ZAT_I_BOOKING
{
  key TravelId,
  key BookingId,
      BookingDate,

      @ObjectModel.text.element : ['CustomerName']
      CustomerId,
      _Customer.LastName as CustomerName,
      @ObjectModel.text.element : ['CarrierName']
      CarrierId,
      _Carrier.Name      as CarrierName,
      ConnectionId,
      FlightDate,
      FlightPrice,
      @Semantics.currencyCode: true
      CurrencyCode,
      BookingStatus,
      LastChangedAt,
      /* Associations */
      _Carrier,
      _Connection,
      _Customer,
      _Status,
      _Suppl,
      _Travel : redirected to parent ZAT_CV_TRAVEL_APPROVER
}
