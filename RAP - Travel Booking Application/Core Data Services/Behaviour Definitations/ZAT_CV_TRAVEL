projection;
strict ( 2 );

define behavior for ZAT_CV_TRAVEL //alias <alias_name>
{
  use create;
  use update;
  use delete;
  use action copyTravel;
  use association _Booking { create; }
}

define behavior for ZAT_CV_BOOKING //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel;
  use association _Suppl { create; }
}

define behavior for ZAT_CV_SUPPLIMENT //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}