CLASS lhc_ZAT_I_BOOKING DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.

    METHODS earlynumbering_cba_Suppl FOR NUMBERING
      IMPORTING entities FOR CREATE zat_i_booking\_Suppl.
    METHODS get_instance_features FOR INSTANCE FEATURES
      keys REQUEST requested_features FOR zat_i_booking RESULT result.
    METHODS calculatetotalprice FOR DETERMINE ON MODIFY
       keys FOR zat_i_booking~calculatetotalprice.

*    METHODS copy FOR MODIFY
*      IMPORTING keys FOR ACTION ZAT_I_BOOKING~copy.

ENDCLASS.

CLASS lhc_ZAT_I_BOOKING IMPLEMENTATION.

  METHOD earlynumbering_cba_Suppl.
    DATA: lv_max_suppl_id TYPE /dmo/supplement_id. " Match your BookingSupplementId field length/type

    " Loop over each Booking instance for which Supplements are being added
    LOOP AT entities ASSIGNING FIELD-SYMBOL(<ls_booking_entity>).

      " 1. Find the highest existing Supplement ID for this Travel ID and Booking ID combination
      SELECT MAX( booking_supplement_id ) FROM zat_suppliment
        WHERE travel_id  = @<ls_booking_entity>-TravelId
          AND booking_id = @<ls_booking_entity>-BookingId
        INTO @lv_max_suppl_id.

      " 2. Loop over new target supplements in the current transactional payload
      LOOP AT <ls_booking_entity>-%target ASSIGNING FIELD-SYMBOL(<ls_new_suppl>).

        " Increment the ID sequentially
        lv_max_suppl_id += 1.

        " 3. Map keys back to the RAP framework
        APPEND VALUE #(
          %cid      = <ls_new_suppl>-%cid
          %key      = VALUE #(
            TravelId            = <ls_booking_entity>-TravelId
            BookingId           = <ls_booking_entity>-BookingId
            BookingSupplementId = lv_max_suppl_id
          )
        ) TO mapped-zat_i_suppliment. " Match your supplement BDEF entity name in lowercase

      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.

*  METHOD copy.
*  ENDMETHOD.

  METHOD get_instance_features.
    READ ENTITIES OF zat_i_travel IN LOCAL MODE
    ENTITY zat_i_travel BY \_Booking
    FIELDS ( BookingStatus )
    WITH CORRESPONDING #( keys )
    RESULT DATA(lt_booking).

    result = VALUE #( FOR ls_booking IN lt_booking ( %tky = ls_booking-%tky
                                                   %features-%assoc-_Suppl     = COND #( WHEN ls_booking-BookingStatus = 'X'
                                                                                            THEN if_abap_behv=>fc-o-disabled
                                                                                            ELSE if_abap_behv=>fc-o-enabled )

                                                                                            ) ).
    READ ENTITIES OF zat_i_travel IN LOCAL MODE
       ENTITY zat_i_travel
       FIELDS ( OverallStatus )
       WITH CORRESPONDING #( keys )
       RESULT DATA(lt_travel).

    LOOP AT result ASSIGNING FIELD-SYMBOL(<ls_res>) .
      LOOP AT lt_travel ASSIGNING FIELD-SYMBOL(<ls_travel>).
        <ls_res>-%features-%delete = COND #( WHEN <ls_travel>-OverallStatus = 'X' THEN if_abap_behv=>fc-o-disabled ELSE if_abap_behv=>fc-o-enabled ).
        EXIT.
      ENDLOOP.
    ENDLOOP.

  ENDMETHOD.

  METHOD calculateTotalPrice.
    DATA: lt_travel TYPE STANDARD TABLE OF  zat_i_travel WITH UNIQUE HASHED KEY Key COMPONENTS TravelId.
    lt_travel = CORRESPONDING #( keys DISCARDING DUPLICATES MAPPING TravelId = TravelId ).
    MODIFY ENTITIES OF zat_i_travel IN LOCAL MODE
    ENTITY zat_i_travel
    EXECUTE recacltotalprice
    FROM CORRESPONDING #( lt_travel ).
  ENDMETHOD.

ENDCLASS.